{
  "version": 1,
  "github": {
    "owner": "your-github-user",
    "cloneProtocol": "https",
    "upstreamRemote": "upstream"
  },
  "checkoutRoot": "/home/you/projects",
  "workspaceTitle": "Main",
  "handoffLanguage": "en",
  "profiles": {
    "codex-high": {
      "provider": "codex",
      "model": "gpt-6.2-sol",
      "thinking": "high",
      "mode": "full-access"
    },
    "claude-sonnet": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "thinking": "high",
      "mode": "bypassPermissions"
    },
    "copilot-sonnet": {
      "provider": "copilot",
      "model": "claude-sonnet-5.5",
      "thinking": null,
      "mode": "allow-all"
    },
    "muse-contributor": {
      "provider": "muse",
      "model": "muse-spark-1.3-contributor",
      "thinking": null,
      "mode": "allowAll"
    }
  },
  "steers": {
    "slots": {
      "A": "codex-high",
      "B": "claude-sonnet",
      "C": "copilot-sonnet"
    },
    "prepare": [
      "A",
      "B",
      "C"
    ],
    "initialActive": "A"
  },
  "workers": {
    "defaultProfile": "muse-contributor"
  },
  "runtime": {
    "stateDir": "~/.local/state/paseo-workspace-factory",
    "paseo": {
      "url": "ws://127.0.0.1:6767/ws",
      "bin": "paseo",
      "passwordFile": null
    }
  }
}
