{
  "name": "paseo-workspace-factory",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Enroll one existing Paseo workspace per scope and steer its coordinator agents.",
  "type": "module",
  "bin": {
    "paseo-factory": "plugin/cli.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=dot --test-timeout=30000 test/*.test.mjs plugin/test/*.test.mjs",
    "test:verbose": "node --experimental-strip-types --test --test-reporter=spec --test-timeout=30000 test/*.test.mjs plugin/test/*.test.mjs",
    "build-snapshot": "node scripts/build-snapshot.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
